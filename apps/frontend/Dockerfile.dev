FROM node:20-slim

WORKDIR /app

# --chown=node:node ensures files are owned by the non-root 'node' user instead of root
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node apps/frontend/package.json apps/frontend/package.json
COPY --chown=node:node apps/backend/package.json apps/backend/package.json

RUN npm ci

COPY --chown=node:node apps/frontend apps/frontend

EXPOSE 3000

# Drop root privileges before starting the process
USER node

CMD ["npm", "run", "-w", "apps/frontend", "dev"]