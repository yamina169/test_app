<!-- ENGLISH VERSION -->
<h1 style='margin:0 0 16px;font-size:24px;font-weight:700;color:#0f172a;'>
  Verify your email
</h1>

<p style='margin:0 0 12px;font-size:16px;line-height:1.7;color:#1e293b;'>
  Hello,
</p>

<p style='margin:0 0 12px;font-size:16px;line-height:1.7;color:#334155;'>
  Thank you for signing up for
  <strong>{{branding.brandTitle}}</strong>.
</p>

<p style='margin:0 0 16px;font-size:16px;color:#334155;'>
  Use this code to verify your email:
</p>

<div style='margin:24px 0;text-align:center;'>
  <span
    style='
    display:inline-block;
    padding:14px 24px;
    font-size:28px;
    font-weight:700;
    letter-spacing:6px;
    background:#f1f5f9;
    border-radius:10px;
    color:#0f172a;
  '
  >
    {{code}}
  </span>
</div>

<p style='margin:0 0 12px;font-size:14px;color:#64748b;'>
  This code will expire in
  <strong>10 minutes</strong>.
</p>

<p style='margin:0;font-size:14px;color:#64748b;'>
  —
  {{branding.teamSignature}}
</p>