# =========================
# Docker
# =========================
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =========================
# MinIO
# =========================
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=documents
MINIO_PUBLIC_URL=http://localhost:9000

# =========================
# Backend
# =========================
BACKEND_PORT=3001

# =========================
# JWT
# =========================
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# =========================
# Frontend 
# =========================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/graphql
NEXT_PUBLIC_API_KEY=your_frontend_api_key

# =========================
# Mail
# =========================
MAIL_HOST=your_mail_host
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_mail_user
MAIL_PASS=your_mail_password
MAIL_DEFAULT_FROM_NAME=YourAppName
MAIL_NO_REPLY=your_no_reply_email
MAIL_CONTACT=your_contact_email
MAIL_FALLBACK_LOCALE=en
MAIL_TEMPLATES_BASE_PATH=src/infrastructure/integrations/mail/templates