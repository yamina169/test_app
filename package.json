{
  "name": "sabilouna",
  "version": "1.0.0",
  "private": true,
  "description": "Sabilouna - Project & Journey Tracking SaaS",
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "build": "npm run build --workspace=apps/backend && npm run build --workspace=apps/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "minimatch": ">=10.2.2",
    "fastify": "5.8.2",
    "@nestjs/platform-fastify": {
      "fastify": "5.8.2"
    },
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@types/hapi__joi": "^17.1.15",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.3",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.20",
    "joi": "^18.1.1"
  }
}
